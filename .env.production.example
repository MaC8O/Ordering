# =============================================================================
# PRODUCTION ENV TEMPLATE — Hostinger shared hosting
# -----------------------------------------------------------------------------
# On the server: copy this to `.env`, fill the ___ placeholders, then run
#   php artisan key:generate
# Do NOT commit the real .env (it holds secrets and is gitignored).
# =============================================================================

APP_NAME="Front Gate Restaurant"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com
APP_TIMEZONE=Asia/Kuala_Lumpur

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# --- Database: create these in hPanel → Databases → Management ---------------
DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=___your_db_name___
DB_USERNAME=___your_db_user___
DB_PASSWORD=___your_db_password___

# Sessions & cache live in the DB (migrations already included).
SESSION_DRIVER=database
SESSION_LIFETIME=1440
SESSION_ENCRYPT=false
SESSION_PATH=/
# Lock cookies to your domain in production:
SESSION_DOMAIN=your-domain.com
# Only send the session cookie over HTTPS (you enabled free SSL in hPanel):
SESSION_SECURE_COOKIE=true

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# 'sync' runs any queued work inline — no background worker needed on shared
# hosting. (Change to 'database' only if you set up a queue:work cron.)
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"

# --- Seeded admin login: SET A STRONG PASSWORD before running the seeder -----
ADMIN_USERNAME=admin
ADMIN_PASSWORD=___set-a-strong-password___

# Twilio SMS — leave blank to log messages instead of sending (demo mode).
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
SMS_DEFAULT_COUNTRY_CODE=+66
